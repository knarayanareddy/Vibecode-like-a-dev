{
  "name": "vibecode-like-a-dev",
  "version": "0.19.0",
  "description": "Turn a one-line idea or an existing repository into an enforceable software factory spec that any coding agent can execute.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vld": "./factory/cli.mjs"
  },
  "files": [
    "factory/cli.mjs",
    "factory/adapters",
    "factory/bundles",
    "factory/catalog",
    "factory/evals",
    "factory/gates",
    "factory/integrations/acp-v1/README.md",
    "factory/integrations/acp-v1/contract.mjs",
    "factory/integrations/acp-v1/index.mjs",
    "factory/integrations/acp-v1/package-lock.json",
    "factory/integrations/acp-v1/package.json",
    "factory/integrations/github-v1/README.md",
    "factory/integrations/github-v1/index.mjs",
    "factory/integrations/github-v1/package.json",
    "factory/lib",
    "factory/modules",
    "factory/overlays",
    "factory/policy.json",
    "factory/routing.json",
    "factory/schema",
    "factory/studio/vscode/extension.cjs",
    "factory/studio/vscode/package.json",
    "factory/studio/vscode/test/extension.test.cjs",
    "factory/templates",
    "factory/test",
    "factory/workflows",
    "primitives",
    "docs",
    "prompts",
    "examples/ideas/01-photo-sorter.json",
    "examples/ideas/02-bike-market.json",
    "examples/ideas/03-standup-bot.json",
    "examples/ideas/04-clinic-bookings.json",
    "examples/ideas/05-payout-ledger.json",
    "examples/ideas/06-habit-sync.json",
    "examples/ideas/07-events-etl.json",
    "examples/ideas/08-flags-sdk.json",
    "examples/ideas/09-docs-assistant.json",
    "examples/ideas/10-log-shipper.json",
    "examples/ideas/adversarial/cases.json",
    "examples/retro-board",
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "index": "node factory/cli.mjs index",
    "lint": "node scripts/lint.mjs",
    "plan": "node factory/cli.mjs plan examples/retro-board/profile.json",
    "compile": "node factory/cli.mjs compile examples/retro-board/profile.json --out examples/retro-board/spec",
    "verify": "node factory/cli.mjs verify examples/retro-board/spec",
    "adopt": "node factory/cli.mjs adopt . -o profile.json",
    "mcp": "node factory/cli.mjs mcp",
    "test": "node --test factory/test/*.test.mjs",
    "check": "npm run lint && npm run index -- --check && npm test && npm run verify && node specs/spec-check.mjs --repo . --strict && node specs/enforcement/gates.mjs --repo . --strict && npm run eval && npm run stress",
    "dogfood": "node factory/cli.mjs compile profile.json -o specs --force && node specs/spec-check.mjs --repo . --strict",
    "stress": "node scripts/stress-test.mjs && node scripts/stress-adversarial.mjs",
    "eval": "node scripts/eval-library.mjs && node scripts/eval-specificity.mjs && node scripts/eval-routing.mjs && node scripts/eval-outcome.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "spec-driven-development",
    "ai-agents",
    "software-factory",
    "engineering-principles",
    "ddd",
    "tdd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knarayanareddy/Vibecode-like-a-dev.git"
  },
  "bugs": {
    "url": "https://github.com/knarayanareddy/Vibecode-like-a-dev/issues"
  },
  "homepage": "https://github.com/knarayanareddy/Vibecode-like-a-dev#readme"
}
