{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/knarayanareddy/Vibecode-like-a-dev/main/factory/schema/spec.schema.json",
  "title": "vibecode-like-a-dev specification manifest",
  "description": "The machine-readable half of a specification packet. Agents read this; humans read the markdown. The drift guard (spec-check.mjs) enforces a subset of it without a JSON Schema library, so keep the two in step.",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "rigor",
    "requirements",
    "gates",
    "docs"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedWith": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "stage",
        "idea"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "web-app",
            "api",
            "cli",
            "library",
            "data-pipeline",
            "mobile",
            "agent",
            "automation"
          ]
        },
        "stage": {
          "enum": [
            "prototype",
            "mvp",
            "internal-tool",
            "production"
          ]
        },
        "idea": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "users": {
          "type": "object",
          "properties": {
            "scale": {
              "enum": [
                "small",
                "medium",
                "large"
              ]
            }
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "constraints": {
          "type": "object"
        }
      }
    },
    "rigor": {
      "type": "object",
      "required": [
        "tier",
        "label",
        "score",
        "packet"
      ],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "array"
        },
        "capped": {
          "type": "boolean"
        },
        "cappedReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "packet": {
          "enum": [
            "full",
            "single-file"
          ]
        }
      }
    },
    "anchorConvention": {
      "type": "object",
      "properties": {
        "marker": {
          "const": "@req"
        },
        "syntax": {
          "type": "string"
        },
        "countedIn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "check": {
          "type": "string"
        }
      }
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "enforces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "statement",
          "acceptance",
          "verify"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d{3}$"
          },
          "key": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 40
          },
          "failurePath": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-\\d{2}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 10
                }
              }
            }
          },
          "verify": {
            "enum": [
              "automated",
              "manual",
              "gate"
            ]
          },
          "anchor": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "todo",
              "done",
              "blocked"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          }
        }
      }
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferred": {
      "type": "array"
    },
    "skipped": {
      "type": "array"
    },
    "stats": {
      "type": "object"
    }
  }
}
